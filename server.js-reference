const express=require('express'),cors=require('cors'),bcrypt=require('bcryptjs'),jwt=require('jsonwebtoken'),sqlite3=require('sqlite3').verbose(),path=require('path');
const app=express(),db=new sqlite3.Database(process.env.DATABASE_PATH||path.join(__dirname,'farmledger.db')),PORT=process.env.PORT||3000;
const SECRET=process.env.JWT_SECRET;if(!SECRET||SECRET.length<32){console.warn('WARNING: Set JWT_SECRET to a random secret of at least 32 characters before use.');}
const JWT_SECRET=SECRET||'development-only-secret-change-me-please-32chars';
app.use(cors({origin:process.env.CORS_ORIGIN||'http://localhost:3000'}));app.use(express.json({limit:'1mb'}));app.use(express.static(path.join(__dirname,'..')));
db.serialize(()=>{db.run('CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT,email TEXT UNIQUE,password TEXT NOT NULL,name TEXT,role TEXT NOT NULL DEFAULT \'farmer\',created_at TEXT DEFAULT CURRENT_TIMESTAMP)');db.run('CREATE TABLE IF NOT EXISTS records(user_id INTEGER PRIMARY KEY,data TEXT NOT NULL,FOREIGN KEY(user_id) REFERENCES users(id))');db.all('PRAGMA table_info(users)',(e,cols)=>{if(!e&&!cols.some(c=>c.name==='role'))db.run("ALTER TABLE users ADD COLUMN role TEXT NOT NULL DEFAULT 'farmer'");if(!e&&!cols.some(c=>c.name==='created_at'))db.run('ALTER TABLE users ADD COLUMN created_at TEXT DEFAULT CURRENT_TIMESTAMP')})});
function auth(req,res,next){try{req.user=jwt.verify((req.headers.authorization||'').replace(/^Bearer\s+/i,''),JWT_SECRET);next()}catch{res.status(401).json({error:'Please sign in again.'})}}
function admin(req,res,next){if(req.user.role!=='admin')return res.status(403).json({error:'Admin access required.'});next()}
function tokenFor(user){return jwt.sign({id:user.id,email:user.email,name:user.name,role:user.role},JWT_SECRET,{expiresIn:'12h'})}
app.post('/api/register',(req,res)=>{let {email,password,name}=req.body||{};email=String(email||'').trim().toLowerCase();name=String(name||'Farmer').trim().slice(0,80);if(!email||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)||!password||password.length<8)return res.status(400).json({error:'Enter a valid email and password (8+ characters).'});const role=process.env.ADMIN_EMAIL&&email===process.env.ADMIN_EMAIL.trim().toLowerCase()?'admin':'farmer';bcrypt.hash(password,12).then(hash=>db.run('INSERT INTO users(email,password,name,role) VALUES(?,?,?,?)',[email,hash,name,role],function(err){if(err)return res.status(409).json({error:'This email may already be registered.'});const user={id:this.lastID,email,name,role};res.json({token:tokenFor(user),user})})).catch(()=>res.status(500).json({error:'Registration failed'}))});
app.post('/api/login',(req,res)=>{const email=String(req.body?.email||'').trim().toLowerCase(),password=String(req.body?.password||'');db.get('SELECT * FROM users WHERE email=?',[email],(err,u)=>{if(err||!u)return res.status(401).json({error:'Email or password incorrect'});bcrypt.compare(password,u.password).then(ok=>{if(!ok)return res.status(401).json({error:'Email or password incorrect'});const user={id:u.id,email:u.email,name:u.name,role:u.role||'farmer'};res.json({token:tokenFor(user),user})})})});
app.get('/api/me',auth,(req,res)=>res.json({id:req.user.id,email:req.user.email,name:req.user.name,role:req.user.role||'farmer'}));
app.get('/api/admin/users',auth,admin,(req,res)=>db.all('SELECT id,email,name,role,created_at FROM users ORDER BY id DESC LIMIT 200',(err,rows)=>err?res.status(500).json({error:'Could not load users'}):res.json(rows)));
app.get('/api/admin/stats',auth,admin,(req,res)=>db.get('SELECT COUNT(*) users, SUM(CASE WHEN role=\'admin\' THEN 1 ELSE 0 END) admins FROM users',(err,row)=>err?res.status(500).json({error:'Could not load stats'}):res.json(row)));
app.get('/api/data',auth,(req,res)=>db.get('SELECT data FROM records WHERE user_id=?',[req.user.id],(err,row)=>{if(err)return res.status(500).json({error:'Could not load data'});try{res.json(row?JSON.parse(row.data):{ledger:[],tasks:[],crops:[]})}catch{res.status(500).json({error:'Stored data is invalid'})}}));
app.put('/api/data',auth,(req,res)=>{const data=req.body;if(!data||!Array.isArray(data.ledger)||!Array.isArray(data.tasks)||!Array.isArray(data.crops)||(data.loans!==undefined&&!Array.isArray(data.loans)))return res.status(400).json({error:'Invalid farm data'});db.run('INSERT INTO records(user_id,data) VALUES(?,?) ON CONFLICT(user_id) DO UPDATE SET data=excluded.data',[req.user.id,JSON.stringify(data)],err=>err?res.status(500).json({error:'Could not save'}):res.json({ok:true}))});
app.get('/api/weather',async(req,res)=>{const lat=Number(req.query.lat),lon=Number(req.query.lon);if(!Number.isFinite(lat)||!Number.isFinite(lon)||Math.abs(lat)>90||Math.abs(lon)>180)return res.status(400).json({error:'Valid latitude and longitude required'});try{const r=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto`);if(!r.ok)throw Error();res.json(await r.json())}catch{res.status(502).json({error:'Weather service unavailable'})}});
// Seed a default login from environment variables (password is stored hashed, never in code).
function seedUser(){const e=String(process.env.SEED_USER_EMAIL||'').trim().toLowerCase(),p=process.env.SEED_USER_PASSWORD,n=String(process.env.SEED_USER_NAME||'Farmer').trim();if(!e||!p)return;db.get('SELECT id FROM users WHERE email=?',[e],(err,row)=>{if(err||row)return;const role=process.env.ADMIN_EMAIL&&e===process.env.ADMIN_EMAIL.trim().toLowerCase()?'admin':'farmer';bcrypt.hash(p,12).then(h=>db.run('INSERT INTO users(email,password,name,role) VALUES(?,?,?,?)',[e,h,n,role],er=>console.log(er?'Seed user failed':'Seed user created: '+e)))})}
setTimeout(seedUser,500);
app.get('/api/health',(req,res)=>res.json({status:'ok'}));app.listen(PORT,()=>console.log(`FarmLedger running at http://localhost:${PORT}`));
